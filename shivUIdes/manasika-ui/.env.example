# Required for server-side image generation; keep this secret on the server.
POLLINATIONS_API_KEY=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
# Optional separate Groq secret for contextual AI Companion replies.
COMPANION_GROQ_API_KEY=
COMPANION_GROQ_MODEL=openai/gpt-oss-20b
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Use a long random value in production. Local development generates a temporary secret if omitted.
MEDIA_SESSION_SECRET=
MEDIA_RETENTION_DAYS=30
MEDIA_GENERATIONS_PER_HOUR=3
MEDIA_GLOBAL_GENERATIONS_PER_HOUR=20
MANASIKA_MEDIA_DATA_DIR=./data
CREATIVE_MEDIA_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8443,http://127.0.0.1:8443

# Optional local Companion model service; used when COMPANION_GROQ_API_KEY is not set.
COMPANION_MODEL_API_URL=

